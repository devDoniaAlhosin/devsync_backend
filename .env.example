PORT=3000
OTP_PEPPER=change-this-long-random-string
OTP_TTL_MS=600000
OTP_RESEND_MS=30000

# Nodemailer / Gmail app password, or leave empty to print codes in the console (dev only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DevSync <noreply@devsync.local>

# Path to a Firebase service-account JSON (Admin SDK, Spark-safe). Do not commit the file.
FIREBASE_SERVICE_ACCOUNT=

# Gemini API for AI-powered matching
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
